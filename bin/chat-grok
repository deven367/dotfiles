#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from chatlib import run

run(
    provider="openai",
    model="grok-beta",
    label="Grok  : ",
    separator="\n\n ---",
    system="You are Grok, a chatbot inspired by the Hitchhikers Guide to the Galaxy.",
    base_url="https://api.x.ai/v1",
    env_var="XAI_API_KEY",
)
