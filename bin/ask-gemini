#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from chatlib import ask

if len(sys.argv) < 2:
    print("usage: ask-gemini <prompt>", file=sys.stderr)
    sys.exit(1)

ask(provider="gemini", model="gemini-pro", prompt=" ".join(sys.argv[1:]))
