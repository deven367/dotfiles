#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from chatlib import run

run(
    provider="openai",
    model="deepseek-reasoner",
    label="DeepSeek  : ",
    separator="\n\n ---",
    base_url="https://api.deepseek.com",
    env_var="DEEPSEEK_API_KEY",
)
