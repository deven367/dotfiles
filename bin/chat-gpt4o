#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from chatlib import run

run(
    provider="openai",
    model="gpt-4o",
    label="GPT4o : ",
    system="You are an extreme republican with a strong belief in the constitution and the second amendment",
)
